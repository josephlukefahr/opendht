Bootstrap: docker
From: ubuntu:22.04
Stage: build

%environment
	export DEBIAN_FRONTEND=noninteractive
	export PATH=/usr/local/bin:$PATH
	export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

%files
	. /usr/local/src/opendht

%post
	# Update apt; minimal interactive defaults
	apt-get update
	apt-get install -y dialog apt-utils
	echo 'debconf debconf/frontend select noninteractive' | debconf-set-selections
	# Install build dependencies
	apt-get install -y\
		build-essential pkg-config cmake git wget meson\
		libtool autotools-dev autoconf\
		python3-pip python3-dev python3-setuptools python3-build python3-virtualenv cython3\
		libncurses5-dev libreadline-dev nettle-dev libcppunit-dev\
		libgnutls28-dev libuv1-dev libjsoncpp-dev libargon2-dev\
		libssl-dev libfmt-dev libasio-dev libmsgpack-dev
	# Install expected-lite header (thirdparty shipped in tree)
	mkdir -p /usr/local/include/nonstd
	cp /usr/local/src/opendht/thirdparty/expected-lite/include/nonstd/expected.hpp /usr/local/include/nonstd/expected.hpp
	# Build and install restinio
	cd /usr/local/src/opendht/thirdparty/restinio/dev
    cmake .\
        -DCMAKE_INSTALL_PREFIX=/usr/local\
        -DRESTINIO_TEST=Off\
        -DRESTINIO_SAMPLE=Off\
        -DRESTINIO_BENCHMARK=Off\
        -DRESTINIO_WITH_SOBJECTIZER=Off\
        -DRESTINIO_DEP_STANDALONE_ASIO=system\
        -DRESTINIO_DEP_LLHTTP=system\
        -DRESTINIO_DEP_FMT=system\
        -DRESTINIO_DEP_EXPECTED_LITE=system
	make && make install
	# Build and install llhttp
	cd /usr/local/src/opendht/thirdparty/llhttp
	mkdir -p build && cd build
	cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local
	make && make install
	# Build and install opendht itself
	cd /usr/local/src/opendht
	mkdir -p build && cd build
    cmake ..\
        -DCMAKE_INSTALL_PREFIX=/usr/local\
        -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=On\
        -DOPENDHT_C=On\
        -DOPENDHT_PEER_DISCOVERY=On\
        -DOPENDHT_PYTHON=Off\
        -DOPENDHT_TOOLS=On\
        -DOPENDHT_PROXY_SERVER=On\
        -DOPENDHT_PROXY_CLIENT=On\
        -DOPENDHT_SYSTEMD=Off\
        -DOPENDHT_DOWNLOAD_DEPS=Off
	make -j$(nproc) && make install

#####

Bootstrap: docker
From: ubuntu:22.04
Stage: final

%files from build
    /usr/local/bin /usr/local
    /usr/local/lib /usr/local

%post
	# Update apt; minimal interactive defaults
	apt-get update
	apt-get install -y dialog apt-utils
	echo 'debconf debconf/frontend select noninteractive' | debconf-set-selections
	# Install runtime dependencies
	apt-get install -y\
		libargon2-1\
        libjsoncpp25\
        libfmt8\
        libreadline8
    # Clean apt cache
    apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/*
